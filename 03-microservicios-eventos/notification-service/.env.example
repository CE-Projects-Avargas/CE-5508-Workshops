# Para correr notification-service fuera de Docker. En docker-compose ya se inyectan.
DB_HOST=notification-db
DB_PORT=3306
DB_NAME=notificaciones
DB_USER=notification_user
DB_PASSWORD=notification_pass
# Solo para el healthcheck: no tiene API publica.
PORT=4200
# De donde consume los eventos
RABBITMQ_URL=amqp://eventos:eventos123@rabbitmq:5672
# Intentos ante un error temporal antes de apartar el mensaje en la DLQ
MAX_INTENTOS=10
