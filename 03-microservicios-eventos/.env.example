# Referencia de las variables del stack. Hoy los valores estan en docker-compose.yml
# para que `docker compose up --build` funcione en un clon limpio.
#
# No hay secreto compartido: auth-service firma con una clave RSA privada que se
# genera sola en el volumen auth_keys (nunca en el repo) y backend y
# device-service verifican con la publica, via GET /auth/jwks.

# --- auth-service -----------------------------------------------------------
JWT_ISSUER=ce5508-auth-service
JWT_AUDIENCE=ce5508-backend
ACCESS_TTL_MIN=15
REFRESH_TTL_H=8

# --- Bases (un usuario por servicio, nunca root) ----------------------------
# auth-db:         base "auth",           usuario auth_user / auth_pass
# backend-db:      base "operacion",      usuario backend_user / backend_pass
# device-db:       base "dispositivos",   usuario device_user / device_pass
# notification-db: base "notificaciones", usuario notification_user / notification_pass
# Cambiar una contrasena con la base ya creada no la migra:
# hace falta `docker compose down -v` para recrear los volumenes.

# --- RabbitMQ ---------------------------------------------------------------
# Usuario eventos / eventos123, panel en http://localhost:15672
RABBITMQ_URL=amqp://eventos:eventos123@rabbitmq:5672

# --- device-service ---------------------------------------------------------
# A quien preguntarle el dueno de un proyecto (dispositivos de proyecto)
BACKEND_URL=http://backend:4000

# --- notification-service ---------------------------------------------------
# Intentos ante un error temporal antes de apartar el mensaje en la DLQ
MAX_INTENTOS=10
