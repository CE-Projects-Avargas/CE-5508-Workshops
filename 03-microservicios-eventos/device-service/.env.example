# Para correr device-service fuera de Docker. En docker-compose ya se inyectan.
DB_HOST=device-db
DB_PORT=3306
DB_NAME=dispositivos
DB_USER=device_user
DB_PASSWORD=device_pass
PORT=4100
# Verifica el token con la clave publica de auth-service, igual que backend.
JWKS_URL=http://auth-service:5001/auth/jwks
JWT_ISSUER=ce5508-auth-service
JWT_AUDIENCE=ce5508-backend
# Donde publica los eventos
RABBITMQ_URL=amqp://eventos:eventos123@rabbitmq:5672
# A quien preguntarle el dueno de un proyecto
BACKEND_URL=http://backend:4000
