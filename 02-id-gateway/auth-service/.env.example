# Para correr auth-service fuera de Docker. En docker-compose ya se inyectan.
DB_HOST=auth-db
DB_PORT=3306
DB_NAME=auth
DB_USER=auth_user
DB_PASSWORD=auth_pass
PORT=5001
# Aqui vive la clave PRIVADA; solo auth-service la monta.
KEYS_DIR=/keys
JWT_ISSUER=ce5508-auth-service
JWT_AUDIENCE=ce5508-backend
ACCESS_TTL_MIN=15
REFRESH_TTL_H=8
