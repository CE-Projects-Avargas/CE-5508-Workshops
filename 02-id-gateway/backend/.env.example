# Para correr el backend fuera de Docker. En docker-compose ya se inyectan.
DB_HOST=backend-db
DB_PORT=3306
DB_NAME=operacion
DB_USER=backend_user
DB_PASSWORD=backend_pass
PORT=4000
# Sin JWT_SECRET: se verifica con la clave publica de auth-service.
JWKS_URL=http://auth-service:5001/auth/jwks
JWT_ISSUER=ce5508-auth-service
JWT_AUDIENCE=ce5508-backend
