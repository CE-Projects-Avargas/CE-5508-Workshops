# Referencia de las variables del stack. Hoy los valores estan en docker-compose.yml
# para que `docker compose up --build` funcione en un clon limpio.
#
# Ya NO existe JWT_SECRET: auth-service firma con una clave RSA privada que se
# genera sola en el volumen auth_keys (nunca en el repo) y los demas servicios
# verifican con la publica, via GET /api/auth/jwks.

# --- auth-service -----------------------------------------------------------
JWT_ISSUER=ce5508-auth-service
JWT_AUDIENCE=ce5508-backend
ACCESS_TTL_MIN=15
REFRESH_TTL_H=8

# --- Bases (un usuario por servicio, nunca root) ----------------------------
# auth-db:    base "auth",      usuario auth_user / auth_pass
# backend-db: base "operacion", usuario backend_user / backend_pass
# Cambiar una contrasena con la base ya creada no la migra:
# hace falta `docker compose down -v` para recrear los volumenes.
