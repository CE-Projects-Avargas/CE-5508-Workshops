# Referencia de las variables del stack. NO se usa todavia.
#
# Hoy los valores estan escritos directamente en docker-compose.yml, para que
# `docker compose up --build` funcione en un clon limpio sin configurar nada.
# Este archivo documenta que variables existen y cual seria un valor real,
# para el dia que se saquen del repositorio.
#
# Para activarlo (cuando haga falta):
#
#   1. cp .env.example .env        <- .env ya esta en .gitignore
#   2. en docker-compose.yml, cambiar cada valor literal por su variable:
#
#        JWT_SECRET: dev-secret-ce5508-cambialo
#        JWT_SECRET: ${JWT_SECRET:-dev-secret-ce5508-cambialo}
#
#      La forma ${VAR:-default} usa el .env si existe y cae al default si no,
#      asi el stack sigue levantando sin configuracion.
#
#   3. docker compose up -d --build


# --- Firma de los tokens ---------------------------------------------------
# El auth-service firma con este valor y el backend verifica con el mismo,
# asi que tiene que ser identico en los dos servicios.
#
# Genera uno propio con:
#
#     openssl rand -hex 32
#
# Quien tenga este valor puede fabricar tokens validos para cualquier usuario.
# Por eso el del repositorio sirve para desarrollo, pero no para un despliegue.
JWT_SECRET=cambiame-por-el-resultado-de-openssl-rand-hex-32

# Minutos que dura un token antes de expirar.
JWT_EXPIRA_MIN=60


# --- Base de datos ---------------------------------------------------------
# DB_PASSWORD tendria que servir para crear la base (MYSQL_ROOT_PASSWORD) y
# para que el backend y el auth-service se conecten: un solo valor en los tres.
#
# Ojo: cambiarla con la base ya creada no la migra. MariaDB conserva la
# contrasena con la que se creo el volumen, asi que hace falta
# `docker compose down -v` para recrearlo.
DB_NAME=dispositivos_medicos
DB_USER=root
DB_PASSWORD=root123
